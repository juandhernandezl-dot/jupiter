<?xml version="1.0"?>
<robot name="ROBOT_ZUMO_URDF.SLDASM">

  <!-- =========================
       BASE
       ========================= -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.0236 -5.1838E-05 -0.0061259" rpy="0 0 0" />
      <mass value="0.11075" />
      <inertia
        ixx="4.9793E-05"
        ixy="3.8196E-08"
        ixz="2.6959E-06"
        iyy="2.5319E-05"
        iyz="-8.3368E-09"
        izz="6.6541E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://zumo_1/meshes/base_link.STL" />
      </geometry>
      <material name="base_light">
        <color rgba="0.93 0.93 0.93 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://zumo_1/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- =========================
       LEFT WHEEL
       ========================= -->
  <link name="left_wheel_link">
    <inertial>
      <origin xyz="6.9713E-07 -1.653E-05 -0.0043321" rpy="0 0 0" />
      <mass value="0.0029113" />
      <inertia
        ixx="2.8399E-07"
        ixy="-4.3011E-12"
        ixz="1.9308E-12"
        iyy="2.8409E-07"
        iyz="-4.5784E-11"
        izz="5.3685E-07" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://zumo_1/meshes/left_wheel_link.STL" />
      </geometry>
      <material name="wheel_dark">
        <color rgba="0.20 0.20 0.20 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://zumo_1/meshes/left_wheel_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="0.02926 0.04866 -0.006" rpy="-1.5708 -0.0058913 0" />
    <parent link="base_link" />
    <child link="left_wheel_link" />
    <axis xyz="0 0 1" />
    <limit effort="100" velocity="100" />
    <dynamics damping="0.005" friction="0.03" />
  </joint>

  <!-- =========================
       RIGHT WHEEL
       ========================= -->
  <link name="right_wheel_link">
    <inertial>
      <origin xyz="3.6323E-07 -1.6541E-05 0.0043321" rpy="0 0 0" />
      <mass value="0.0029113" />
      <inertia
        ixx="2.8399E-07"
        ixy="-2.2425E-12"
        ixz="-1.0061E-12"
        iyy="2.8409E-07"
        iyz="4.5814E-11"
        izz="5.3685E-07" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://zumo_1/meshes/right_wheel_link.STL" />
      </geometry>
      <material name="wheel_dark_r">
        <color rgba="0.20 0.20 0.20 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://zumo_1/meshes/right_wheel_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="0.02926 -0.04888 -0.006" rpy="-1.5708 -0.0058913 0" />
    <parent link="base_link" />
    <child link="right_wheel_link" />
    <axis xyz="0 0 1" />
    <limit effort="100" velocity="100" />
    <dynamics damping="0.005" friction="0.03" />
  </joint>

  <!-- =========================
       RIGHT IDLER
       ========================= -->
  <link name="right_idler_link">
    <inertial>
      <origin xyz="1.3878E-17 -1.3878E-17 0.0054685" rpy="0 0 0" />
      <mass value="0.0030148" />
      <inertia
        ixx="2.9977E-07"
        ixy="-3.7071E-20"
        ixz="1.5007E-23"
        iyy="2.9977E-07"
        iyz="-2.5771E-23"
        izz="5.6146E-07" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://zumo_1/meshes/right_idler_link.STL" />
      </geometry>
      <material name="idler_dark_r">
        <color rgba="0.25 0.25 0.25 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://zumo_1/meshes/right_idler_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="right_idler_joint" type="continuous">
    <origin xyz="-0.01974 -0.05063 -0.0062887" rpy="-1.5708 -0.0058913 0" />
    <parent link="base_link" />
    <child link="right_idler_link" />
    <axis xyz="0 0 1" />
    <limit effort="100" velocity="100" />
    <dynamics damping="0.001" friction="0.005" />
  </joint>

  <!-- =========================
       LEFT IDLER
       ========================= -->
  <link name="left_idler_link">
    <inertial>
      <origin xyz="2.0817E-17 1.3878E-17 -0.0054685" rpy="0 0 0" />
      <mass value="0.0030148" />
      <inertia
        ixx="2.9977E-07"
        ixy="3.7601E-20"
        ixz="-1.1937E-23"
        iyy="2.9977E-07"
        iyz="8.6886E-24"
        izz="5.6146E-07" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://zumo_1/meshes/left_idler_link.STL" />
      </geometry>
      <material name="idler_dark_l">
        <color rgba="0.25 0.25 0.25 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://zumo_1/meshes/left_idler_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="left_idler_joint" type="continuous">
    <origin xyz="-0.01974 0.05041 -0.0062887" rpy="-1.5708 -0.0058913 0" />
    <parent link="base_link" />
    <child link="left_idler_link" />
    <axis xyz="0 0 1" />
    <limit effort="100" velocity="100" />
    <dynamics damping="0.001" friction="0.005" />
  </joint>

  <!-- =========================
       LEFT TRACK — oruga silicona Pololu 22T
       preserveFixedJoint evita que el convertidor URDF→SDF
       fusione este link con base_link (link lumping).
       Sin esto, el plugin no encuentra left_track_link.
       ========================= -->
  <link name="left_track_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="1e-6" ixy="0" ixz="0"
               iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://zumo_1/meshes/left_track_link.STL" />
      </geometry>
      <material name="track_dark_l">
        <color rgba="0.08 0.08 0.08 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://zumo_1/meshes/left_track_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="left_track_joint" type="fixed">
    <origin xyz="0.0048605 0.04466 -0.00614" rpy="0 -0.0058913 0" />
    <parent link="base_link" />
    <child link="left_track_link" />
  </joint>

  <!-- preserveFixedJoint en el joint de la track izquierda -->
  <gazebo reference="left_track_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <!-- =========================
       RIGHT TRACK — oruga silicona Pololu 22T
       ========================= -->
  <link name="right_track_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="1e-6" ixy="0" ixz="0"
               iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://zumo_1/meshes/right_track_link.STL" />
      </geometry>
      <material name="track_dark_r">
        <color rgba="0.08 0.08 0.08 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://zumo_1/meshes/right_track_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="right_track_joint" type="fixed">
    <origin xyz="0.0048605 -0.04488 -0.00614" rpy="0 -0.0058913 0" />
    <parent link="base_link" />
    <child link="right_track_link" />
  </joint>

  <!-- preserveFixedJoint en el joint de la track derecha -->
  <gazebo reference="right_track_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <!-- =========================
       IMU
       ========================= -->
  <link name="imu_link"/>

  <joint name="imu_joint" type="fixed">
    <origin xyz="0.0 0 0.0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="imu_link" />
    <axis xyz="1 0 0" />
  </joint>

  <gazebo reference="imu_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>imu_data</topic>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <topicName>imu_data</topicName>
        <bodyName>imu_link</bodyName>
        <updateRateHZ>10.0</updateRateHZ>
        <gaussianNoise>0.005</gaussianNoise>
        <xyzOffset>0 0 0</xyzOffset>
        <rpyOffset>0 0 0</rpyOffset>
        <frameName>imu_link</frameName>
        <initialOrientationAsReference>true</initialOrientationAsReference>
      </plugin>
      <pose>0 0 0 0 0 0</pose>
    </sensor>
  </gazebo>

  <!-- =========================
       GAZEBO CONTACT PARAMETERS
       ========================= -->
  <gazebo reference="base_link">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>100000</kp>
    <kd>10.0</kd>
    <material>Gazebo/White</material>
  </gazebo>

  <!-- Orugas de silicona Pololu 22T:
       mu1 (dirección de avance, fdir1=X): 1.5 → tracción longitudinal
       mu2 (lateral):                      0.3 → permite giro diferencial
       kp más bajo que ABS porque silicona es más deformable -->
  <gazebo reference="left_track_link">
    <mu1>1.5</mu1>
    <mu2>0.3</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>80000</kp>
    <kd>5.0</kd>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="right_track_link">
    <mu1>1.5</mu1>
    <mu2>0.3</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>80000</kp>
    <kd>5.0</kd>
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- Sprockets ABS: fricción baja, no son los que traccionan -->
  <gazebo reference="left_wheel_link">
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
    <kp>120000</kp>
    <kd>10.0</kd>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
    <kp>120000</kp>
    <kd>10.0</kd>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="left_idler_link">
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
    <kp>120000</kp>
    <kd>10.0</kd>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="right_idler_link">
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
    <kp>120000</kp>
    <kd>10.0</kd>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- =========================
       SIMPLE TRACKED VEHICLE PLUGIN
       Escucha el tópico Gazebo interno ~/cmd_vel_twist (Twist).
       Para bridgearlo desde ROS 2 /cmd_vel se usa el plugin
       libgazebo_ros_planar_move definido abajo.
       ========================= -->
  <gazebo>
    <plugin name="simple_tracked_vehicle" filename="libSimpleTrackedVehiclePlugin.so">
      <body>base_link</body>
      <left_track>left_track_link</left_track>
      <right_track>right_track_link</right_track>
      <track_mu>1.5</track_mu>
      <track_mu2>0.3</track_mu2>
      <steering_efficiency>1.0</steering_efficiency>
      <tracks_separation>0.08954</tracks_separation>
      <max_linear_speed>0.4</max_linear_speed>
      <max_angular_speed>2.0</max_angular_speed>
    </plugin>
  </gazebo>

  <!-- =========================
       PLANAR MOVE PLUGIN (puente ROS2 → Gazebo)
       El SimpleTrackedVehiclePlugin es un plugin puro de
       Gazebo Classic (no gazebo_ros), por lo que NO expone
       un tópico ROS directamente. Este plugin sí es gazebo_ros
       y publica /cmd_vel como ROS 2 Twist, aplicando la
       velocidad al base_link. Trabaja en paralelo con el
       SimpleTrackedVehiclePlugin para que el teleop funcione.
       ========================= -->
  <gazebo>
    <plugin name="gazebo_ros_planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>100</update_rate>
      <publish_rate>10</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
  </gazebo>

  <!-- =========================
       JOINT STATE PUBLISHER FOR IDLERS
       ========================= -->
  <gazebo>
    <plugin name="gazebo_ros_joint_state_publisher"
            filename="libgazebo_ros_joint_state_publisher.so">
      <update_rate>50</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>left_idler_joint</joint_name>
      <joint_name>right_idler_joint</joint_name>
    </plugin>
  </gazebo>

</robot>